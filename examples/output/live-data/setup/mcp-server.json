{
  "mcpServers": {
    "google-ads": {
      "command": "pipx",
      "args": [
        "run",
        "--spec",
        "google-ads-mcp==0.0.6",
        "google-ads-mcp"
      ],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "/Users/you/.config/gcloud/application_default_credentials.json",
        "GOOGLE_PROJECT_ID": "northside-ads-reports",
        "GOOGLE_ADS_MCP_TOOLS_CONFIG": "/Users/you/Developer/google-ads-skills/examples/output/live-data/setup/tools_config.yaml"
      }
    }
  }
}
