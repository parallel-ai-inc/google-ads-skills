          "status": "seen",
          "note": "seen with campaign in working queries"
        },
        {
          "field": "metrics.all_conversions_value",
          "used_in": "select",
          "status": "seen",
          "note": "seen with campaign in working queries"
        },
        {
          "field": "segments.date",
          "used_in": "condition",
          "status": "seen",
          "note": "seen with campaign in working queries"
        }
      ],
      "parameters": {
        "customer_id": "1234567890",
        "resource": "campaign",
        "fields": [
          "segments.conversion_action_name",
          "metrics.conversions",
          "metrics.conversions_value",
          "metrics.all_conversions",
          "metrics.all_conversions_value"
        ],
        "conditions": [
          "segments.date BETWEEN '2026-10-14' AND '2026-11-12'"
        ],
        "limit": 10000
      }
    }
  ],
  "join_key": [
    "segments.conversion_action_name",
    "conversion_action.name"
  ],
  "columns": [
    {
      "header": "Conversion action",
      "field": "conversion_action.name",
      "kind": "text"
    },
    {
      "header": "Action optimization",
      "field": "conversion_action.primary_for_goal",
      "kind": "primary"
    },
    {
      "header": "Conversion source",
      "field": "conversion_action.type",
      "kind": "enum"
    },
    {
      "header": "Category",
      "field": "conversion_action.category",
      "kind": "enum"
    },
    {
      "header": "Count",
      "field": "conversion_action.counting_type",
      "kind": "enum"
    },
    {
      "header": "Click-through conv. window",
      "field": "conversion_action.click_through_lookback_window_days",
      "kind": "days"
    },
    {
      "header": "View-through conv. window",
      "field": "conversion_action.view_through_lookback_window_days",
      "kind": "days"
    },
    {
      "header": "Attribution model",
      "field": "conversion_action.attribution_model_settings.attribution_model",
