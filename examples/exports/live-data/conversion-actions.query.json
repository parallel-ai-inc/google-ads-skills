{
  "kind": "report",
  "report": "conversion-actions",
  "title": "Conversion actions",
  "file": "conversion-actions-summary.csv",
  "total": "Total: Conversion actions",
  "customer_id": "1234567890",
  "start": "2026-10-14",
  "end": "2026-11-12",
  "tool": "search_search",
  "parameters": {
    "customer_id": "1234567890",
    "resource": "conversion_action",
    "fields": [
      "conversion_action.name",
      "conversion_action.primary_for_goal",
      "conversion_action.type",
      "conversion_action.category",
      "conversion_action.counting_type",
      "conversion_action.click_through_lookback_window_days",
      "conversion_action.view_through_lookback_window_days",
      "conversion_action.attribution_model_settings.attribution_model"
    ],
    "conditions": [
      "conversion_action.status = 'ENABLED'"
    ],
    "orderings": [
      "conversion_action.name ASC"
    ],
    "limit": 10000
  },
  "result": "conversion-actions.result.json",
  "joins": [
    {
      "name": "conversions-by-action",
      "result": "conversions-by-action.result.json",
      "field_checks": [
        {
          "field": "segments.conversion_action_name",
          "used_in": "select",
          "status": "seen",
          "note": "seen with campaign in working queries"
        },
        {
          "field": "metrics.conversions",
          "used_in": "select",
          "status": "seen",
          "note": "seen with campaign in working queries"
        },
        {
          "field": "metrics.conversions_value",
          "used_in": "select",
          "status": "seen",
          "note": "seen with campaign in working queries"
        },
        {
          "field": "metrics.all_conversions",
